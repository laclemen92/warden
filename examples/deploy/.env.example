# Copy to .env and fill in. Never commit .env. See docs/deployment.md.

# Image to run. Pin a digest from the release notes so it can't change underneath you:
#   ghcr.io/laclemen92/warden@sha256:<digest>
WARDEN_IMAGE=ghcr.io/laclemen92/warden:1.0.0-rc.1
# Development-only mock IdP, used only with docker-compose.mock-oidc.yml. Use the same version.
# MOCK_OIDC_IMAGE=ghcr.io/laclemen92/warden-mock-oidc:1.0.0-rc.1

# --- Database ------------------------------------------------------------------------------
# Warden reads your tables and writes its own `warden` schema in the same database.
# Local copy (bundled `db` service):  postgres://warden:warden@db:5432/app
# Your database (restricted role):     postgres://warden_app:<password>@<host>:5432/<db>
#   From inside Docker, use host.docker.internal to reach a database on the host machine.
DATABASE_URL=postgres://warden:warden@db:5432/app
# Set to false when a separate owner role runs migrations (docs/database.md).
# WARDEN_MIGRATE=false

# --- Where people open Warden --------------------------------------------------------------
# Must be https except on localhost. Register <url>/auth/callback as the redirect URI and
# <url>/ as the post-logout redirect URI at your identity provider.
WARDEN_PUBLIC_URL=http://localhost:3000

# --- Sign-in (OIDC) -------------------------------------------------------------------------
# Google: https://accounts.google.com. Entra: https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile

# Signs session cookies. Generate with: openssl rand -base64 32
WARDEN_SESSION_SECRET=
