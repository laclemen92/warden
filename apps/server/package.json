{
  "name": "@wardenhq/server",
  "version": "0.0.0",
  "description": "Warden API server",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "@wardenhq/config": "workspace:*",
    "@wardenhq/core": "workspace:*",
    "@wardenhq/pg-adapter": "workspace:*",
    "fastify": "^5.12.7",
    "openid-client": "^6.8.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@wardenhq/mock-oidc": "workspace:*",
    "@wardenhq/testing": "workspace:*",
    "pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
