# Copy to apps/server/.env for `pnpm dev`. Values match `docker compose up -d postgres mock-oidc`.
DATABASE_URL=postgres://warden:warden@localhost:5432/example
WARDEN_CONFIG=../../examples/basic/warden.config.yaml
WARDEN_ACTIONS=../../examples/basic/actions/index.js

# Browsers reach Warden through the Vite dev server, which proxies /api and /auth.
WARDEN_PUBLIC_URL=http://localhost:5173
OIDC_ISSUER=http://localhost:9400
OIDC_CLIENT_ID=warden
OIDC_CLIENT_SECRET=warden-dev-secret
OIDC_SCOPES=openid email profile groups
WARDEN_SESSION_SECRET=local-dev-session-secret-not-for-production
# WARDEN_SESSION_IDLE_TIMEOUT=2h
# WARDEN_SESSION_ABSOLUTE_TIMEOUT=12h
# WARDEN_MIGRATE=true
# WARDEN_BODY_LIMIT=1mb
# WARDEN_DB_IDLE_IN_TRANSACTION_TIMEOUT=60s
# WARDEN_EXPORT_IDLE_TIMEOUT=30s
# WARDEN_EXPORT_DEADLINE=15m
# WARDEN_EXPORT_MAX_CONCURRENT=4
# WARDEN_EXPORT_MAX_PER_USER=2
